APP_ENV=local

# docker-compose map Postgres ra 5434, Redis ra 6380 (port mặc định bị dự án cũ chiếm)
DATABASE_URL=postgresql+asyncpg://smartroom:smartroom@localhost:5434/smartroom
REDIS_URL=redis://localhost:6380/0

AWS_REGION=ap-southeast-1
# Dev local: LocalStack (docker compose up -d). Production: xóa 3 dòng dưới -> IAM role
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_BILLING_QUEUE_URL=http://localhost:4566/000000000000/smartroom-billing
S3_INVOICE_BUCKET=smartroom-invoices
